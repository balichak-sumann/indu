# Conversational AI Agent Configuration

# API Configuration
API_TITLE=Conversational AI Agent
API_VERSION=1.0.0
API_DESCRIPTION=Production-grade conversational voice AI for Indian market
DEBUG=false

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Sarvam AI Configuration
# Get your API key from https://www.sarvam.ai
SARVAM_API_KEY=your-api-key-here
SARVAM_LLM_MODEL=Meta-Llama-3-8B-Instruct
SARVAM_STT_MODEL=sarvam-speech-recognition-en-in
SARVAM_TTS_MODEL=meera
SARVAM_API_BASE_URL=https://api.sarvam.ai

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=3600

# PostgreSQL Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/conversational_ai

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=1000

# Audio Configuration
SAMPLE_RATE=16000
CHANNELS=1
CHUNK_SIZE=1024
MAX_AUDIO_LENGTH=300

# Response Configuration
STREAMING_ENABLED=true
RESPONSE_TIMEOUT=30

# Logging
LOG_LEVEL=INFO

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
